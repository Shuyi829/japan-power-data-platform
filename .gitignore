# Secrets (keep .env.example tracked)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Data (bronze/silver/gold files are regenerated by the pipeline)
data/
!data/.gitkeep

# DuckDB
*.duckdb
*.duckdb.wal

# dbt build output
dbt/**/target/
dbt/**/dbt_packages/
dbt/**/logs/
.user.yml

# Dagster
.dagster_home/
dagster_home/

# Logs / temp
logs/
*.log
tmp*/
*.tmp

# Safety net: private reference material never belongs in this repo
# (public-data-only rule). Keep such files outside the project folder.
useful resources/
private/
*.doc
*.docx
*.pptx
*.xlsx

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
